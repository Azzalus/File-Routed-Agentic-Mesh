{
  "data": {
    "artifact": {
      "unknown_terms": [],
      "avoid_synonyms": [],
      "ste_violations": 0
    },
    "grilling_log": {
      "rounds": 1,
      "questions_without_manual_response": 0,
      "max_rounds": 2
    },
    "drift": {
      "tier": "none",
      "response": null
    },
    "vocabulary": {
      "terms": []
    }
  },
  "policy": {
    "policy_name": "grilling-suite-conformance",
    "version": "1.0.0",
    "gates": [
      {
        "id": "AC4a-vocabulary-coverage",
        "level": 1,
        "assertion": "len(data['artifact']['unknown_terms']) == 0",
        "failure_action": "ABORT",
        "rule": "AC4(a)-unknown-term"
      },
      {
        "id": "AC4b-no-avoid-synonyms",
        "level": 1,
        "assertion": "len(data['artifact']['avoid_synonyms']) == 0",
        "failure_action": "ABORT",
        "rule": "AC4(b)-avoid-synonym"
      },
      {
        "id": "AC4c-ste-form",
        "level": 1,
        "assertion": "data['artifact']['ste_violations'] == 0",
        "failure_action": "ABORT",
        "rule": "AC4(c)-ste"
      },
      {
        "id": "AC4d-round-before-finalize",
        "level": 1,
        "assertion": "data['grilling_log']['rounds'] >= 1 and data['grilling_log']['rounds'] <= data['grilling_log']['max_rounds']",
        "failure_action": "ABORT",
        "rule": "AC4(d)-round-before-finalize"
      },
      {
        "id": "AC4e-manual-response",
        "level": 1,
        "assertion": "data['grilling_log']['questions_without_manual_response'] == 0",
        "failure_action": "ABORT",
        "rule": "AC4(e)-manual-response"
      },
      {
        "id": "AC4f-drift-halt",
        "level": 1,
        "assertion": "data['drift']['tier'] != 'structural' or data['drift']['response'] == 'halt'",
        "failure_action": "ABORT",
        "rule": "AC4(f)-structural-halt"
      }
    ]
  }
}
